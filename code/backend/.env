
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Where MongoDB lives.
#   Local install (Windows or the AWS server):  mongodb://127.0.0.1:27017/gridgame
#   MongoDB Atlas (cloud):  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/gridgame
MONGO_URI=mongodb://127.0.0.1:27017/gridgame

# Long random string that signs login cookies. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=97282e8987ebb7f1ee84f23ece0e7bc3e4cafa54bbfb812146493f1e0ffea2bcfcef719c8c4a9b522e80f3f70b162608

PORT=3000

# auto  = login cookie is "Secure" only when the visitor uses https (Cloudflare) - recommended
# true / false to force it
COOKIE_SECURE=auto

# Trust X-Forwarded-* headers from a proxy on this machine (cloudflared, nginx).
TRUST_PROXY=loopback

# Players allowed per game. 0 = no limit.
MAX_PLAYERS_PER_GAME=0

# Only set this if the website is hosted on a DIFFERENT domain than this server.
# CLIENT_ORIGIN=https://your-frontend.example.com